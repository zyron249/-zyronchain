# ZYRON NODE local configuration checklist.
# Copy to .env and export the variables, or pass them through Docker Compose.
# Never commit a real .env, bot token, admin token, or database password.
# This service does not mint ZYN, does not store keys, and does not pay a treasury.

# development | test | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL. The API applies SQL migrations on startup.
DATABASE_URL=postgresql://zyron:zyron@127.0.0.1:5432/zyron_node

# Optional. Used as a cache for read-only Zyron RPC responses.
# Rate limits stay in PostgreSQL.
# REDIS_URL=redis://127.0.0.1:6379/0

# From BotFather. Required for initData checks and the bot process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL of this Mini App. Required before Telegram will open the menu button.
WEBAPP_URL=

# Bearer token for /admin. At least 24 characters in production.
ADMIN_TOKEN=

# How long a Telegram initData payload stays valid.
INIT_DATA_MAX_AGE_SECONDS=43200

# Local-only escape hatches. Both must stay off in production.
DEV_AUTH_BYPASS=0
ALLOW_TEST_CLOCK=0

# Read-only Zyron RPC. Leave empty until you run your own node.
# There is no hosted public RPC in this repository.
# Loopback HTTP is allowed. Any other host needs HTTPS and ZYRON_RPC_ALLOW_REMOTE=1.
ZYRON_RPC_URL=
ZYRON_RPC_ALLOW_REMOTE=0

# Salt for signup-network hashes. Change this before any shared deployment.
REFERRAL_IP_SALT=dev-salt-change-me
REFERRAL_MIN_AGE_SECONDS=1800
REFERRAL_MIN_CYCLES=15
CYCLE_MIN_INTERVAL_MS=800

# Set to 1 only behind a trusted reverse proxy.
TRUST_PROXY=0
