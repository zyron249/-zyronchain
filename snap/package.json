{
  "name": "@zyronchain/metamask-snap",
  "version": "0.1.0",
  "private": true,
  "description": "ZyronChain MetaMask Snap: derives a ZyronChain secp256k1 key from the MetaMask SRP and signs canonical L1 transfers offline. NOT AUDITED, NOT LISTED, TESTNET ONLY.",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyron249/-zyronchain.git"
  },
  "license": "(MIT-0 OR Apache-2.0)",
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "mm-snap build",
    "build:clean": "npm run clean && npm run build",
    "clean": "rimraf dist",
    "l1:build": "npm --prefix ../l1 ci --ignore-scripts --no-audit --no-fund && npm --prefix ../l1 run build",
    "manifest": "mm-snap manifest",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "pretest": "npm run build",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "12.0.1",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@metamask/key-tree": "^10.1.1",
    "@metamask/snaps-cli": "8.4.1",
    "@metamask/snaps-jest": "10.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/react": "18.2.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
