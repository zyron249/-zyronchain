  "securityInvariants": [
    {
      "id": "CONS-001",
      "statement": "Finalized non-genesis blocks require unique configured-validator attestations at floor(2N/3)+1 quorum.",
      "primaryModules": ["l1/src/block.ts", "l1/src/chain.ts"]
    },
    {
      "id": "CONS-002",
      "statement": "A non-zero consensus round requires sequential predecessor skip-quorum evidence; rounds cannot be jumped without certified evidence.",
      "primaryModules": ["l1/src/block.ts", "l1/src/node.ts"]
    },
    {
      "id": "SIGN-001",
      "statement": "Validator signing reserves durable anti-equivocation state before local or remote signing output is requested.",
      "primaryModules": ["l1/src/storage.ts", "l1/src/node.ts", "l1/src/validator-signer.ts"]
    },
    {
      "id": "CHAIN-001",
      "statement": "Chain ID, genesis identity, protocol version and active validator schedule are validated before accepting consensus history.",
      "primaryModules": ["l1/src/chain.ts", "l1/src/storage.ts"]
    },
    {
      "id": "STATE-001",
      "statement": "Block validation re-executes transactions and requires the deterministic authenticated state root committed by the block.",
      "primaryModules": ["l1/src/chain.ts", "l1/src/state-v2.ts"]
    },
    {
      "id": "SUPPLY-001",
      "statement": "Genesis allocation is capped at 50M ZYN and normal execution cannot increase total state supply.",
      "primaryModules": ["l1/src/chain.ts", "l1/src/types.ts"]
    },
    {
      "id": "RECOVERY-001",
      "statement": "Checkpoint/state installation requires independently supplied finalized-tip and snapshot-digest anchors and validates the restored chain through the normal recovery path.",
      "primaryModules": ["l1/src/storage.ts", "l1/src/p2p-checkpoint.ts", "l1/src/p2p-state.ts"]
    },
    {
      "id": "NET-001",
      "statement": "Native P2P authenticates node identity and binds peers to chain/genesis while enforcing bounded streams, frames, work and sync responses.",
      "primaryModules": ["l1/src/p2p.ts", "l1/src/peer-identity.ts", "l1/src/p2p-sync.ts"]
    },
    {
      "id": "RPC-001",
      "statement": "Non-loopback RPC is fail-closed unless consensus authentication and an exact HTTPS-enforcing trusted proxy are configured.",
      "primaryModules": ["l1/src/node.ts", "l1/src/cli.ts"]
    },
    {
      "id": "GOV-001",
      "statement": "Validator-set and protocol updates require current-set quorum authorization and delayed activation; unsupported activated protocol versions fail closed.",
      "primaryModules": ["l1/src/transaction.ts", "l1/src/chain.ts"]
    },
    {
      "id": "KEY-001",
      "statement": "After quorum-authorized validator-key replacement activates, the retired key is no longer an active consensus signer and the replacement set persists across restart.",
      "primaryModules": ["l1/src/chain.ts", "l1/src/block.ts"]
    }
  ],
  "requiredCommands": [
    "npm ci",
    "npm run typecheck",
    "npm test",
    "npm audit --omit=dev --audit-level=high",
    "npm sbom --omit=dev --sbom-format=spdx"
  ],
  "evidenceScenarios": [
