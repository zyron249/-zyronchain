# Example only. These names are not read by the checked-in node.
# A deployment must supply them in the process environment after governance approval.
# Empty values, PLACEHOLDER, CHANGEME, example.com, localhost, and 127.0.0.1 fail closed.
# TLS terminates at the operator reverse proxy. The proxy alone may set X-Forwarded-Proto
# to https and is the only address passed to --rpc-trusted-proxy. The public RPC role
# must not forward consensus paths.
ZYRON_PUBLIC_RPC_ORIGIN=
ZYRON_PUBLIC_RPC_BIND=
ZYRON_PUBLIC_RPC_RATE_LIMIT=
ZYRON_PUBLIC_RPC_MAX_BODY=
ZYRON_PUBLIC_RPC_TIMEOUT_MS=
ZYRON_PUBLIC_RPC_TRUSTED_PROXY=
