{
  "name": "@zyronchain/l1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "zyron-l1": "dist/src/secure-cli.js"
  },
  "files": [
    "dist/src",
    "scripts/mine.mjs",
    "README.md",
    "MINING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "mine": "node scripts/mine.mjs",
    "bench:restart": "npm run build && node dist/bench/restart.js",
    "bench:state-scale": "npm run build && node dist/bench/state-v2-scale.js",
    "bench:state-resume-scale": "npm run build && node dist/bench/state-v2-resume-scale.js",
    "test": "npm run build && node --check scripts/mine.mjs && node scripts/test-suite.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/crypto": "5.1.22",
    "@libp2p/interface": "3.2.5",
    "@libp2p/peer-id": "6.0.14",
    "@libp2p/tcp": "11.0.26",
    "@multiformats/multiaddr": "13.0.3",
    "better-sqlite3": "13.0.3",
    "libp2p": "3.3.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.13",
    "typescript": "6.0.2"
  }
}
