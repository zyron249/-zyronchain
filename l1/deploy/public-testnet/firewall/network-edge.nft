#!/usr/sbin/nft -f
# Network-boundary policy for one Zyron role. This is not an application allow-list.
# Apply it on the host or the region edge. Consensus and signer ports have no public accept rule.
# Replace __ASSIGNED_BOOTSTRAP_PORT__ only on bootstrap hosts.

table inet zyron_edge {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif "lo" accept
    tcp dport 443 accept comment "HTTPS public RPC only"
    tcp dport __ASSIGNED_BOOTSTRAP_PORT__ accept comment "assigned bootstrap P2P port only"
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }
}
