# ZyronChain environment checklist
#
# Copy values into your shell, systemd unit, or process manager.
# The node and the legacy Flask app do NOT auto-load this file.
# Never commit a real .env, keystore, password file, or token.
#
# .gitignore already ignores .env, .env.*, *.pem, *.key, wallet.json,
# validator-key.json, oracle-key.json, and peer/signer token files.
# This example file is the only .env* name that may be committed.

# -----------------------------------------------------------------------------
# Canonical TypeScript L1 (l1/)
# -----------------------------------------------------------------------------

# Required when a command reads an encrypted keystore. Must be a regular
# owner-only file (0600), 12–1024 characters, optional single trailing newline.
# ZYRON_KEYSTORE_PASSWORD_FILE=/secure/path/validator-a.password

# Packaged miner home (optional). Leave unset to use the miner default.
# ZYRON_MINER_HOME=

# Private Render rehearsal only. These do not publish a public testnet.
# Default chain ID in l1/scripts/render-private-testnet.mjs:
# ZYRON_TESTNET_CHAIN_ID=zyron-render-private-testnet-1
# ZYRON_TESTNET_DATA_ROOT=
# ZYRON_TESTNET_RPC_BASE_PORT=9137
# PORT=10000

# Local benchmarks / CI scale harnesses (optional).
# ZYRON_BENCH_BLOCKS=500
# ZYRON_SCALE_ACCOUNTS=10000

# -----------------------------------------------------------------------------
# Legacy Python/Flask compatibility testnet (app.py) — not the canonical chain
# -----------------------------------------------------------------------------

# DATABASE_URL=postgresql://127.0.0.1:5432/zyron
# ZYRON_ADMIN_TOKEN=
# ZYRON_RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# ZYRON_ENABLE_TESTNET_FAUCET=0
# ZYRON_LEGACY_PUBLIC_QUARANTINE=1
# PORT=5000
